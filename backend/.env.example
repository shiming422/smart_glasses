# Required
DASHSCOPE_API_KEY=sk-xxxx

# Model paths (relative to project root or absolute)
BLIND_PATH_MODEL=model/yolo-seg.pt
OBSTACLE_MODEL=model/yoloe-11l-seg.pt
YOLOE_MODEL_PATH=model/yoloe-11l-seg.pt
YOLO_MODEL_PATH=model/shoppingbest5.pt
HAND_TASK_PATH=model/hand_landmarker.task
TRAFFICLIGHT_MODEL=model/trafficlight.pt

# Audio paths (relative to project root or absolute)
AUDIO_BASE_DIR=music
VOICE_DIR=voice
AIGLASS_AUDIO_DIR=music

# Web/Network
AIGLASS_HOST=0.0.0.0
AIGLASS_PORT=8765
AIGLASS_PORT_FALLBACK=1
AIGLASS_UDP_PORT=12345
AIGLASS_DISCOVERY_PORT=54321
AIGLASS_AUDIO_WS_ENABLED=1
AIGLASS_CAMERA_SOURCE=cpp_gateway
AIGLASS_CAMERA_CPP_GATEWAY_ENABLED=1
AIGLASS_CAMERA_CPP_GATEWAY_MODE=external
AIGLASS_CAMERA_GATEWAY_TCP_HOST=127.0.0.1
AIGLASS_CAMERA_GATEWAY_TCP_BIND_HOST=0.0.0.0
AIGLASS_CAMERA_GATEWAY_TCP_PORT=22346
AIGLASS_CAMERA_UDP_PORT=22345
AIGLASS_CAMERA_UDP_FRAME_TTL_MS=250
AIGLASS_CAMERA_CTRL_WS_ENABLED=1
AIGLASS_CAMERA_AUTOTUNE_WARMUP_SEC=35

# Optional runtime flags
ENABLE_TTS=true
TTS_INTERVAL_SEC=1.0
AIGLASS_AUDIO_VERBOSE=0
AIGLASS_ECHO_TAIL_MS=800

# Fallback/debug camera path: ESP32A direct WebSocket JPEG.
AIGLASS_CAMERA_WS_URL=ws://127.0.0.1:8765/ws/camera

# Legacy RV1106 over HEVC/TCP path, only if intentionally testing that chain.
AIGLASS_CAMERA_HEVC_URL=tcp://<rv1106-ip>:9000
AIGLASS_CAMERA_PREVIEW_RTSP_URL=rtsp://<rv1106-ip>/live/0
AIGLASS_CAMERA_FFMPEG=ffmpeg
AIGLASS_CAMERA_HEVC_FPS=20
AIGLASS_CAMERA_HEVC_RECONNECT_MS=1000
AIGLASS_CAMERA_PREVIEW_FPS=20
AIGLASS_CAMERA_PREVIEW_RECONNECT_MS=1000
AIGLASS_CAMERA_PIPELINE_FPS=24
AIGLASS_CAMERA_PIPELINE_IDLE_MS=8
AIGLASS_VIEWER_JPEG_QUALITY=88
AIGLASS_VIEWER_ZOOM=1.0
AIGLASS_VIEWER_SEND_TIMEOUT_MS=5000
AIGLASS_MAX_VIEWERS=16
AIGLASS_AUTO_RECORD=0
AIGLASS_VIEWER_POSTPROCESS=1
AIGLASS_VIEWER_BRIGHTNESS=-4
AIGLASS_VIEWER_CONTRAST=1.03
AIGLASS_VIEWER_RED_GAIN=1.03
AIGLASS_VIEWER_GREEN_GAIN=0.95
AIGLASS_VIEWER_BLUE_GAIN=1.00
AIGLASS_VIEWER_GAMMA=1.06
AIGLASS_VIEWER_SATURATION=1.02
AIGLASS_VIEWER_SHARPEN=0.03
AIGLASS_VIEWER_BLACK_POINT=0
AIGLASS_VIEWER_CLAHE_CLIP=0.0
AIGLASS_VIEWER_CLAHE_GRID=8

# Navigation viewer display. 0 uses the native backend OpenCV annotated JPEG
# during navigation; 1 keeps raw preview and relies on frontend overlays.
AIGLASS_NAV_DIRECT_VIEWER=0
AIGLASS_PATH_FRAME_DIV=2
AIGLASS_NAV_INFER_MIN_INTERVAL_MS=750
AIGLASS_NAV_VIEWER_FRAME_DIV=4
AIGLASS_NAV_RAW_BETWEEN_OVERLAYS=1
AIGLASS_OVERLAY_STALE_MS=400

# Keep ESP32B /stream.wav connected even when no TTS audio is queued.
AIGLASS_STREAM_IDLE_SILENCE=1
AIGLASS_STREAM_IDLE_SILENCE_MS=20
